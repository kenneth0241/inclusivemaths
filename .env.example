# Knowledge API key from Dify (Knowledge > API). Never expose this in the browser.
DIFY_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxxxx

# Include /v1. Cloud default is https://api.dify.ai/v1
DIFY_API_BASE=https://api.dify.ai/v1

# Google Drive — optional API key (folder must be "Anyone with the link")
# Without this, the app uses the public folder listing for downloads.
# GOOGLE_DRIVE_API_KEY=AIza...
# GOOGLE_DRIVE_TEXTBOOK_FOLDER_ID=10NxpupZ1VsEEQ_DkYRr-wZRnBg-EqlVz

# MathsTextbook dataset UUID from the knowledge base URL in Dify (NOT API keys)
# Example: https://cloud.dify.ai/datasets/33d81571-24cf-42d1-bd02-e7ae78408564/...
DIFY_DATASET_TEXTBOOK=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Chat with Textbook — your published Dify Chatflow app API key
DIFY_APP_CHAT_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: separate base URL for chat app (usually same as DIFY_API_BASE)
# DIFY_APP_CHAT_API_BASE=

# Lesson plan Workflow app (POST /workflows/run)
DIFY_APP_LESSON_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Chatflow app for multi-turn lesson refine (POST /chat-messages)
# DIFY_APP_LESSON_REFINE_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# DIFY_APP_LESSON_API_BASE=
# DIFY_APP_LESSON_REFINE_API_BASE=

# Optional: Workflow to analyze chat for teaching topic (POST /workflows/run, blocking)
# Start inputs: chat_history (or conversation_transcript), grade, subject, chat_conversation_id
# End outputs: topic, confidence (0-100), ready, suggested_question, reason (or JSON in text)
# DIFY_APP_TOPIC_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# DIFY_APP_TOPIC_API_BASE=

# Step 2 Profile Synthesizer workflow (learner + Step 1 footprint)
# Copy this file to .env.local and paste your app key from Dify → Profile Synthesizer → API Access.
# DIFY_APP_PROFILE_SYNTHESIS_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# DIFY_APP_PROFILE_SYNTHESIS_API_BASE=

# Step 3 Pedagogical Strategy — must match Dify app type:
# DIFY_APP_PEDAGOGY_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# DIFY_APP_PEDAGOGY_APP_MODE=workflow
# DIFY_APP_PEDAGOGY_APP_MODE=chatflow
#
# Step 3 individualized student refine (separate Dify app):
# Start inputs: topic_summary, scope_and_constraints, visual_models,
# current_theory, current_strategy, learner_profile (+ query / chat_history)
# DIFY_APP_PEDAGOGY_INDIVIDUAL_API_KEY=app-xxxxxxxxxxxxxxxxxxxxxxxx
# DIFY_APP_PEDAGOGY_INDIVIDUAL_APP_MODE=chatflow
# DIFY_APP_PEDAGOGY_INDIVIDUAL_API_BASE=
