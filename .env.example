# Knowledge API key from Dify (Knowledge > API). Never expose this in the browser.
DIFY_API_KEY=dataset-xxxxxxxxxxxxxxxxxxxxxxxx

# Include /v1. Cloud default is https://api.dify.ai/v1
# Self-hosted example: http://localhost/v1
DIFY_API_BASE=https://api.dify.ai/v1

# Optional: lock teachers to one knowledge base. Leave empty to let them pick.
# DIFY_DATASET_ID=
